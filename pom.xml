<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>3.5.7</version>
        <relativePath/>
    </parent>

    <groupId>io.github.yusupoff03</groupId>
    <artifactId>logstream-parent</artifactId>
    <version>0.0.1</version>
    <packaging>pom</packaging>

    <name>LogStream Parent</name>
    <description>Multi-module parent for the LogStream Spring Boot starter</description>
    <url>https://github.com/yusupoff03/logstream</url>

    <licenses>
        <license>
            <name>MIT License</name>
            <url>http://www.opensource.org/licenses/mit-license.php</url>
        </license>
    </licenses>

    <developers>
        <developer>
            <id>yusupoff03</id>
            <name>Yusupov Ulug'bek</name>
            <email>yusupovulugbek73@gmail.com</email>
        </developer>
    </developers>

    <scm>
        <connection>scm:git:git://github.com/yusupoff03/logstream.git</connection>
        <developerConnection>scm:git:ssh://github.com:yusupoff03/logstream.git</developerConnection>
        <url>https://github.com/yusupoff03/logstream</url>
    </scm>

    <!-- ── Modules ─────────────────────────────────────────────────── -->
    <modules>
        <module>logstream-core</module>
        <module>logstream-storage-jdbc</module>
        <module>logstream-storage-mongodb</module>
        <module>logstream-spring-boot-starter</module>
        <module>demo</module>
    </modules>

    <!-- ── Properties ─────────────────────────────────────────────── -->
    <properties>
        <java.version>17</java.version>
    </properties>

    <!-- ── Dependency Management ──────────────────────────────────── -->
    <!--
        Pin inter-module artifact versions here once so every child module
        can reference siblings without repeating the version literal.
    -->
    <dependencyManagement>
        <dependencies>
            <dependency>
                <groupId>io.github.yusupoff03</groupId>
                <artifactId>logstream-core</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>io.github.yusupoff03</groupId>
                <artifactId>logstream-storage-jdbc</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>io.github.yusupoff03</groupId>
                <artifactId>logstream-storage-mongodb</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>io.github.yusupoff03</groupId>
                <artifactId>logstream-spring-boot-starter</artifactId>
                <version>${project.version}</version>
            </dependency>
        </dependencies>
    </dependencyManagement>

    <!-- ── Build ──────────────────────────────────────────────────── -->
    <build>
        <pluginManagement>
            <plugins>
                <!--
                    Library modules must NOT be repackaged as executable fat JARs.
                    Skip is the default here; the demo module overrides it to false.
                -->
                <plugin>
                    <groupId>org.springframework.boot</groupId>
                    <artifactId>spring-boot-maven-plugin</artifactId>
                    <configuration>
                        <skip>true</skip>
                    </configuration>
                </plugin>

                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-javadoc-plugin</artifactId>
                    <version>3.3.0</version>
                    <executions>
                        <execution>
                            <id>attach-javadocs</id>
                            <goals><goal>jar</goal></goals>
                        </execution>
                    </executions>
                </plugin>

                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-source-plugin</artifactId>
                    <version>3.2.1</version>
                    <executions>
                        <execution>
                            <id>attach-sources</id>
                            <goals><goal>jar-no-fork</goal></goals>
                        </execution>
                    </executions>
                </plugin>

                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-gpg-plugin</artifactId>
                    <version>1.6</version>
                    <executions>
                        <execution>
                            <id>sign-artifacts</id>
                            <phase>verify</phase>
                            <goals><goal>sign</goal></goals>
                        </execution>
                    </executions>
                </plugin>
            </plugins>
        </pluginManagement>
    </build>

    <pluginRepositories>
        <pluginRepository>
            <id>sonatype-central</id>
            <url>https://central.sonatype.com/repository/maven-public/</url>
        </pluginRepository>
    </pluginRepositories>

</project>
