<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>io.github.yusupoff03</groupId>
        <artifactId>logstream-parent</artifactId>
        <version>0.0.1</version>
    </parent>

    <artifactId>logstream-storage-mongodb</artifactId>
    <name>LogStream Storage — MongoDB</name>
    <description>
        MongoDB storage implementation for LogStream.
        Provides MongoLogStorage and MongoStorageProvider.
        Registers itself as a StorageProvider when MongoTemplate is on the classpath.
    </description>

    <dependencies>

        <!-- Core contracts (LogStorage, StorageProvider, LogEntry) -->
        <dependency>
            <groupId>io.github.yusupoff03</groupId>
            <artifactId>logstream-core</artifactId>
        </dependency>

        <!--
            MongoDB support — provided/optional for the same reason as JDBC above.
            The consumer application supplies spring-boot-starter-data-mongodb.
        -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-data-mongodb</artifactId>
            <scope>provided</scope>
            <optional>true</optional>
        </dependency>

        <!-- Auto-configuration support -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-autoconfigure</artifactId>
            <scope>provided</scope>
        </dependency>

    </dependencies>

</project>
